<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.nginx-stream</string>

    <!-- Redis-over-Tailscale TCP proxy. Separate from org.nginx ON PURPOSE:
         it binds a Tailscale address, and nginx treats an unassignable bind
         as fatal. Isolated here, a Tailscale-not-up-yet boot costs only this
         proxy; the HTTP edge on :80/:443 is unaffected. -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/nginx</string>
        <string>-p</string>
        <string>/Users/matthew/deploy/nginx-stream</string>
        <string>-c</string>
        <string>/Users/matthew/deploy/nginx-stream/nginx.conf</string>
        <string>-g</string>
        <string>daemon off;</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Unconditional KeepAlive is the retry mechanism: at boot this will fail
         with [emerg] bind() until Tailscale assigns 100.83.62.68, then succeed
         and stay up. ThrottleInterval keeps that from being a hot loop. -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>15</integer>

    <key>StandardOutPath</key>
    <string>/Users/matthew/deploy/nginx-stream/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/matthew/deploy/nginx-stream/logs/launchd.err.log</string>
</dict>
</plist>
