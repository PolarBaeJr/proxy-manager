# --- Cloudflare (optional; enables the dashboard's DNS tab) ---
# The token is normally all you need. Give it Zone.DNS:Edit plus account-level
# Zone:Read and the dashboard discovers every active zone in the account on its
# own, re-checking every 5 minutes — a domain added to Cloudflare shows up in
# the DNS tab with no env edit and no restart.
CLOUDFLARE_API_TOKEN=

# Pin the DEFAULT zone (optional) — the one the DNS tab opens on and the one
# used when a request carries no ?zone= selector. Without these, the default is
# whichever discovered zone sorts first.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_DOMAIN=yourdomain.com

# Extra zones (optional, and rarely needed now that discovery exists). Use this
# when a zone needs its OWN token — e.g. it lives in a different account, or the
# main token has no Zone:Read and so can't enumerate anything. Comma-separated
# "domain:zoneid" entries, each with an optional third field overriding
# CLOUDFLARE_API_TOKEN for that zone. Entries here are pinned: discovery never
# overwrites or removes them. Malformed entries are skipped with a log line.
#   CLOUDFLARE_ZONES=the-aquarium.com:<zoneid>,otherdomain.com:<zoneid>:<token>
CLOUDFLARE_ZONES=

# Attribution secret (optional but recommended with more than one user).
# generate: openssl rand -hex 32 — shared by proxy and dashboard ONLY.
# Lets the proxy tell the dashboard which person a service-to-service call
# (e.g. via the MCP server) was made for, so the audit log names them instead
# of the shared API token. Used for the audit label and nothing else: it never
# grants access. Kept separate from PMGR_AUTH_SECRET so a backend that can
# verify attributions cannot forge sessions or OAuth access tokens.
# Unset => actions are audited as the API token's owner, with a startup warning.
PMGR_ACTOR_SECRET=

# --- MCP server (optional; exposes dashboard operations as MCP tools) ---
# Served BY THE DASHBOARD on :8097 and proxied at mcp.<domain>/mcp/dashboard
# via a static route in cmd/proxy/routes.json. There is no separate service and
# NO API TOKEN to create: the tools dispatch through the dashboard's own
# handlers in-process, using a credential the process mints for itself at
# startup and never writes down.
#
# Access is gated by the proxy's oauth mode, which binds a token to that exact
# host+path — an obsidian token cannot be replayed against the dashboard MCP.
#
# Empty => read-only tools (list services/routes/DNS, logs, maintenance status).
# true  => also maintenance on/off, scale, start/stop, autoupdate, canary.
MCP_ALLOW_WRITES=

# --- Edge / TLS (only used with `--profile edge`) ---
# Comma-separated domains for Let's Encrypt autocert.
# Must already point at this host's public IP (port 80 reachable for ACME).
EDGE_DOMAINS=

# --- Edge peer gossip (optional; cluster-wide rate limiting) ---
# Comma-separated base URLs of OTHER edge instances' internal metrics ports.
# Each edge pushes per-IP consumption deltas to peers every 2s so the -rate
# cap applies across the whole mesh instead of per-instance.
# Example: EDGE_PEERS=http://edge-eu.tailnet:8094,http://edge-us.tailnet:8094
EDGE_PEERS=
# Shared bearer for gossip auth. Must match on every peer. Generate with:
#   openssl rand -hex 32
# Empty disables both /gossip receive and outbound push.
EDGE_PEER_SECRET=

# --- Shared rate-limit store (optional; cross-peer rate limiting) ---
# Address of a single Redis instance shared by every proxy in the mesh, so a
# proxy.ratelimit cap applies across ALL proxies collectively instead of per
# instance — same idea as EDGE_PEERS above, but for the proxy's per-route
# rate limiter rather than edge's per-IP one. Currently expected to live on
# the Mac mini peer node, bound to its Tailscale IP (not one Redis per host).
# Empty (default) => today's in-memory-only rate limiting, unchanged — a
# Redis outage or unset REDIS_ADDR both degrade to the same per-instance
# behavior, never fully unlimited.
#   REDIS_ADDR=100.83.62.68:6379
REDIS_ADDR=
# Required alongside REDIS_ADDR. Generate with: openssl rand -hex 32 (or any
# strong password) — must match the Redis instance's own configured password.
REDIS_PASSWORD=

# --- TLS cert probing (optional; surfaces cert expiry on the dashboard's Stats tab) ---
# Comma-separated SNI hostnames. The prober dials host.docker.internal:443 (i.e. nginx
# on the host) with each SNI and records the served origin cert's expiry + issuer.
# Format: "host.example.com" or "host.example.com@1.2.3.4:8443" to dial a custom target.
TLS_PROBE_TARGETS=
